<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="komika"
        Arguments=""
        InstallLocation="C:\Program Files\Komika\Komika">
    </Installer>
    <PackageInformation
        PackageName="Komika"
        PackageDisplayName="Komika"
        PublisherName="CN=Komika"
        PublisherDisplayName="Komika"
        Version="0.1.0.0"
        PackageDescription="Cross-platform manga viewer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.komika.app"
                Description="Cross-platform manga viewer"
                DisplayName="Komika"
                ExecutableName="komika"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Komika</DisplayName>
            <PublisherDisplayName>Komika</PublisherDisplayName>
            <Description>Cross-platform manga viewer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="komika.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
